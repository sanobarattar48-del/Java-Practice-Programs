class Parent {
    int number = 10;
}

class Child extends Parent {
    int number = 20;

    void display() {
        System.out.println("Child: " + number);
        System.out.println("Parent: " + super.number);
    }
}

public class Main {
    public static void main(String[] args) {
        Child c = new Child();
        c.display();
    }
}
