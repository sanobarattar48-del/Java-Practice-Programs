class Vehicle {
    void run() {
        System.out.println("Vehicle is running at high speed.");
    }
}

class Bike extends Vehicle {
    void run() {
        System.out.println("Bike is running smoothly.");
    }
}

public class Main {
    public static void main(String[] args) {
        Vehicle v1 = new Vehicle();
        Vehicle v2 = new Bike();

        v1.run();
        v2.run();
    }
}
