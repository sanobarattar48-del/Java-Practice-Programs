public class Main {
    public static void main(String[] args) {
        int[] a = {10, 20, 30, 40, 50};
        int n = 2;

        System.out.println("Original Array:");
        for (int x : a) {
            System.out.print(x + " ");
        }

        for (int k = 0; k < n; k++) {
            int first = a[0];

            for (int i = 0; i < a.length - 1; i++) {
                a[i] = a[i + 1];
            }

            a[a.length - 1] = first;
        }

        System.out.println("\nAfter Left Rotation:");
        for (int x : a) {
            System.out.print(x + " ");
        }
    }
}
