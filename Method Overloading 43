class Calculator {
    int add(int a, int b) {
        return a + b;
    }

    int add(int a, int b, int c) {
        return a + b + c;
    }

    double add(double a, double b) {
        return a + b;
    }

    public static void main(String[] args) {
        Calculator c = new Calculator();

        System.out.println("Sum of 2 integers: " + c.add(4, 6));
        System.out.println("Sum of 3 integers: " + c.add(4, 6, 8));
        System.out.println("Sum of 2 doubles: " + c.add(4.5, 6.5));
    }
}
