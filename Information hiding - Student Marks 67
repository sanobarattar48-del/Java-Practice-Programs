class Student {
    private int marks;

    void setMarks(int marks) {
        this.marks = marks;
    }

    void displayMarks() {
        System.out.println("Marks: " + marks);
    }
}

public class Main {
    public static void main(String[] args) {
        Student s = new Student();

        s.setMarks(85);
        s.displayMarks();
    }
}
